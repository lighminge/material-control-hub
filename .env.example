# reCAPTCHA Enterprise site key used by Firebase App Check (public value, not a secret).
# Copy this file to .env.local (local dev) and set the same variable in your hosting build environment.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional: fixed App Check debug token for local development (registered in Firebase Console).
VITE_APPCHECK_DEBUG_TOKEN=
# Firebase Authentication is used for user sign-in.

